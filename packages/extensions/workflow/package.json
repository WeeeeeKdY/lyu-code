{
  "name": "lyu-extension-workflow",
  "version": "0.2.0",
  "description": "Workflow extension for lyu-code — visually compose multi-agent pipelines",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm --prefix ../wf-agent-guard run build && tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('../wf-agent-guard/dist/index.js', 'dist/agent-guard.js')\"",
    "test": "node test/ask.e2e.mjs"
  },
  "files": [
    "dist",
    "frontend/dist"
  ],
  "pi": {
    "extensions": [
      "dist/index.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WeeeeeKdY/lyu-code.git",
    "directory": "packages/extensions/workflow"
  }
}
