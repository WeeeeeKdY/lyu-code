{
  "name": "lyu-code",
  "version": "0.2.0",
  "private": true,
  "description": "自带引擎的 coding agent：vendored pi 1.5.2 + 7 个随包扩展，只提供 lyu 命令",
  "type": "module",
  "scripts": {
    "lyu": "node packages/agent/bin/lyu.js",
    "init": "node packages/agent/bin/lyu-init.js",
    "vendor": "node packages/agent/scripts/vendor.mjs",
    "setup": "npm --prefix packages/extensions-pi install && npm --prefix packages/agent install"
  },
  "engines": {
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WeeeeeKdY/lyu-code.git"
  },
  "homepage": "https://github.com/WeeeeeKdY/lyu-code",
  "keywords": [
    "coding-agent",
    "ai",
    "cli",
    "llm",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "WeeeeeKdY"
}
